@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model PaginationResponse<ServiceOrderDTO>

@{
    bool canSeeAll = ViewBag.CanSeeAll as bool? ?? false;
    Guid? currentUserId = ViewBag.CurrentUserId as Guid?;
    OrderStatus? currentStatus = ViewBag.Status as OrderStatus?;

    ViewData["Title"] = canSeeAll ? "Órdenes de servicio" : "Mis órdenes asignadas";

    bool canCreate = (await AuthorizationService.AuthorizeAsync(User, HasPermissionAttribute.PolicyPrefix + PermissionsCatalog.Orders.Create)).Succeeded;
    bool canAttend = (await AuthorizationService.AuthorizeAsync(User, HasPermissionAttribute.PolicyPrefix + PermissionsCatalog.Orders.Attend)).Succeeded;
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="card">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title">Listado de órdenes</h5>
                @if (canCreate)
                {
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle"></i> Nueva orden
                    </a>
                }
            </div>

            <form asp-action="Index" method="get" class="row g-2 mb-3">
                <input type="hidden" name="Page" value="1" />

                <div class="col-auto">
                    <select name="RecordsPerPage" class="form-select" onchange="this.form.submit()" aria-label="Registros por página">
                        <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                        <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                        <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                        <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                    </select>
                </div>

                <div class="col-auto">
                    <select name="Status" class="form-select" onchange="this.form.submit()" aria-label="Filtrar por estado">
                        <option value="">Todos los estados</option>
                        @foreach (OrderStatus status in Enum.GetValues<OrderStatus>())
                        {
                            <option value="@status" selected="@(status == currentStatus)">@OrderStatusRules.Name(status)</option>
                        }
                    </select>
                </div>

                <div class="col">
                    <div class="input-group">
                        <input name="Filter" value="@Model.Filter" type="text" class="form-control"
                               placeholder="Buscar por N° de orden, cliente, documento, marca, modelo o serial..."
                               aria-label="Buscar" />
                        <button type="submit" class="btn btn-primary" aria-label="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Recepción</th>
                            <th>Cliente</th>
                            <th>Equipo</th>
                            <th>Falla reportada</th>
                            <th>Técnico</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.List.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">No se encontraron órdenes.</td>
                            </tr>
                        }

                        @foreach (ServiceOrderDTO item in Model.List)
                        {
                            bool isFinal = OrderStatusRules.IsFinal(item.Status);
                            bool showAttend = canAttend && !isFinal && item.TechnicianId is not null
                                              && (item.TechnicianId == currentUserId || canSeeAll);

                            <tr>
                                <td><a asp-action="Details" asp-route-id="@item.Id" class="fw-bold">@item.Number</a></td>
                                <td>@item.ReceptionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@item.CustomerName</td>
                                <td>@item.DeviceDescription</td>
                                <td title="@item.ReportedIssue">
                                    @(item.ReportedIssue.Length > 45 ? item.ReportedIssue[..45] + "…" : item.ReportedIssue)
                                </td>
                                <td>
                                    @if (item.TechnicianName is null)
                                    {
                                        <span class="badge bg-light text-dark border">Sin asignar</span>
                                    }
                                    else
                                    {
                                        @item.TechnicianName
                                    }
                                </td>
                                <td><partial name="_OrderStatusBadge" model="item.Status" /></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@item.Id"
                                       data-bs-toggle="tooltip" data-bs-title="Ver detalle">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    @if (showAttend)
                                    {
                                        <a class="btn btn-sm btn-warning" asp-action="Attend" asp-route-id="@item.Id"
                                           data-bs-toggle="tooltip" data-bs-title="Registrar atención">
                                            <i class="bi bi-tools"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav aria-label="Paginación de órdenes">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="1"
                           asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter" asp-route-Status="@currentStatus">
                            <i class="bi bi-chevron-double-left"></i>
                        </a>
                    </li>
                    <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(Model.CurrentPage - 1)"
                           asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter" asp-route-Status="@currentStatus">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @foreach (int pageNumber in Model.Pages)
                    {
                        <li class="page-item @(Model.CurrentPage == pageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-Page="@pageNumber"
                               asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter" asp-route-Status="@currentStatus">
                                @pageNumber
                            </a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@(Model.CurrentPage + 1)"
                           asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter" asp-route-Status="@currentStatus">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-Page="@Model.TotalPages"
                           asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter" asp-route-Status="@currentStatus">
                            <i class="bi bi-chevron-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]')
            .forEach(el => new bootstrap.Tooltip(el));
    </script>
}

