@model OrderDetailsViewModel

<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Cancel" method="post" class="modal-content">
            <input type="hidden" name="ServiceOrderId" value="@Model.Order.Id" />

            <div class="modal-header">
                <h5 class="modal-title" id="cancelModalLabel">Cancelar orden N° @Model.Order.Number</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="alert alert-warning">
                    Esta acción no se puede deshacer: una orden cancelada no se puede reabrir.
                </div>

                <div class="form-floating">
                    <textarea name="Reason" class="form-control" style="height: 110px" maxlength="500" required
                              placeholder="Motivo de cancelación"></textarea>
                    <label>Motivo de cancelación</label>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Volver</button>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-x-circle"></i> Cancelar orden
                </button>
            </div>
        </form>
    </div>
</div>
