@model OrderDetailsViewModel

<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AssignTechnician" method="post" class="modal-content">
            <input type="hidden" name="ServiceOrderId" value="@Model.Order.Id" />

            <div class="modal-header">
                <h5 class="modal-title" id="assignModalLabel">
                    @(Model.Order.TechnicianId is null ? "Asignar técnico" : "Cambiar técnico")
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                @if (Model.Order.TechnicianName is not null)
                {
                    <p class="text-muted">Técnico actual: <strong>@Model.Order.TechnicianName</strong></p>
                }

                @if (!Model.Technicians.Any())
                {
                    <div class="alert alert-warning mb-0">
                        No hay técnicos activos disponibles. Cree un usuario con un rol que tenga el permiso de atender órdenes.
                    </div>
                }
                else
                {
                    <div class="form-floating">
                        <select name="TechnicianId" asp-items="Model.Technicians" class="form-select" required>
                            <option value="">Seleccione un técnico</option>
                        </select>
                        <label>Técnico</label>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" disabled="@(!Model.Technicians.Any())">
                    <i class="bi bi-person-check"></i> Guardar
                </button>
            </div>
        </form>
    </div>
</div>
