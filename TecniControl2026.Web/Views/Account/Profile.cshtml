@model TecniControl2026.Web.DTOs.Account.ProfileDTO

@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container mt-4">
    <h2>Mi Perfil</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Profile" method="post">
                <!-- Validation summary for overall model errors -->
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">Nombres</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">Apellidos</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <!-- Read-only fields that cannot be modified directly by the user -->
                <div class="mb-3">
                    <label class="form-label">Correo Electrónico</label>
                    <input asp-for="Email" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Documento</label>
                    <input asp-for="Document" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Rol</label>
                    <input asp-for="RoleName" class="form-control" readonly />
                </div>

                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}