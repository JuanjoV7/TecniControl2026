@model PaginationResponse<EquipoDTO>

@{
    ViewData["Title"] = "Equipos";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li><li class="breadcrumb-item active">@ViewData["Title"]</li></ol></nav>
</div>

<section class="section">
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="card-title">Listado de equipos</h5>
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> Nuevo equipo</a>
            </div>

            <form asp-action="Index" method="get" class="row g-2 mb-3">
                <input type="hidden" name="Page" value="1" />
                <div class="col-auto">
                    <select asp-for="RecordsPerPage" class="form-select">
                        <option value="10" selected="@(Model.RecordsPerPage == 10)">10</option>
                        <option value="15" selected="@(Model.RecordsPerPage == 15)">15</option>
                        <option value="30" selected="@(Model.RecordsPerPage == 30)">30</option>
                        <option value="50" selected="@(Model.RecordsPerPage == 50)">50</option>
                    </select>
                </div>
                <div class="col">
                    <div class="input-group">
                        <input asp-for="Filter" type="text" class="form-control" placeholder="Buscar por cliente, documento, marca, modelo o serial..." aria-label="Buscar" />
                        <button type="submit" class="btn btn-primary" aria-label="Buscar"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th>Cliente</th><th>Documento</th><th>Tipo</th><th>Marca</th><th>Modelo</th><th>Serial</th><th class="text-end">Acciones</th></tr>
                    </thead>
                    <tbody>
                        @if (!Model.List.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted">No se encontraron equipos.</td></tr>
                        }
                        @foreach (EquipoDTO item in Model.List)
                        {
                            <tr>
                                <td>@item.ClienteNombre</td>
                                <td>@item.ClienteDocumento</td>
                                <td>@Html.DisplayFor(_ => item.Tipo)</td>
                                <td>@item.Marca</td>
                                <td>@item.Modelo</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Serial) ? "Sin serial" : item.Serial)</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id" data-bs-toggle="tooltip" data-bs-title="Editar"><i class="bi bi-pencil-fill"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger btnDelete"
                                                data-equipo="@item.Descripcion"
                                                data-bs-toggle="tooltip" data-bs-title="Eliminar">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav aria-label="Paginación de equipos">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-Page="1" asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter"><i class="bi bi-chevron-double-left"></i></a></li>
                    <li class="page-item @(!Model.HasPrevious ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-Page="@(Model.CurrentPage - 1)" asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter"><i class="bi bi-chevron-left"></i></a></li>
                    @foreach (int pageNumber in Model.Pages)
                    {
                        <li class="page-item @(Model.CurrentPage == pageNumber ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-Page="@pageNumber" asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter">@pageNumber</a></li>
                    }
                    <li class="page-item @(!Model.HasNext ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-Page="@(Model.CurrentPage + 1)" asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter"><i class="bi bi-chevron-right"></i></a></li>
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-Page="@Model.TotalPages" asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter"><i class="bi bi-chevron-double-right"></i></a></li>
                </ul>
            </nav>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]')
            .forEach(element => new bootstrap.Tooltip(element));

        $(document).on('click', '.btnDelete', function (event) {
            event.preventDefault();

            const form = $(this).closest('form');
            const equipo = $(this).data('equipo');

            Swal.fire({
                icon: 'question',
                title: '¿Desea eliminar el equipo?',
                text: equipo,
                showCancelButton: true,
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then(result => {
                if (result.isConfirmed) {
                    form.trigger('submit');
                }
            });
        });
    </script>
}
