@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model PaginationResponse<RoleDTO>
@{
    ViewData["Title"] = "Roles y permisos";
    bool canCreate = (await AuthorizationService.AuthorizeAsync(User, HasPermissionAttribute.PolicyPrefix + PermissionsCatalog.Roles.Create)).Succeeded;
    bool canUpdate = (await AuthorizationService.AuthorizeAsync(User, HasPermissionAttribute.PolicyPrefix + PermissionsCatalog.Roles.Update)).Succeeded;
    bool canDelete = (await AuthorizationService.AuthorizeAsync(User, HasPermissionAttribute.PolicyPrefix + PermissionsCatalog.Roles.Delete)).Succeeded;
}
<div class="pagetitle"><h1>@ViewData["Title"]</h1><nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li><li class="breadcrumb-item active">Roles</li></ol></nav></div>
<section class="section"><div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center"><h5 class="card-title">Listado de roles</h5>@if (canCreate) { <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> Nuevo rol</a> }</div>
    <form asp-action="Index" method="get" class="row g-2 mb-3"><input type="hidden" name="Page" value="1" /><div class="col-auto"><select asp-for="RecordsPerPage" class="form-select"><option value="10">10</option><option value="15">15</option><option value="30">30</option><option value="50">50</option></select></div><div class="col"><div class="input-group"><input asp-for="Filter" class="form-control" placeholder="Buscar por nombre o descripción..." /><button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button></div></div></form>
    <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Nombre</th><th>Descripción</th><th>Permisos</th><th>Usuarios</th><th class="text-end">Acciones</th></tr></thead><tbody>
    @if (!Model.List.Any()) { <tr><td colspan="5" class="text-center text-muted">No se encontraron roles.</td></tr> }
    @foreach (RoleDTO item in Model.List)
    {
        bool isAdministrator = item.Name == BaseRoles.Administrator;
        <tr><td>@item.Name</td><td>@(item.Description ?? "Sin descripción")</td><td><span class="badge bg-primary">@item.Permissions.Count</span></td><td>@item.UserCount</td><td class="text-end">
        @if (canUpdate && !isAdministrator) { <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id" title="Editar"><i class="bi bi-pencil-fill"></i></a> }
        @if (canDelete && !isAdministrator) { <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-danger btnDelete" data-role="@item.Name" title="Eliminar"><i class="bi bi-trash-fill"></i></button></form> }
        </td></tr>
    }
    </tbody></table></div>
    <nav><ul class="pagination justify-content-center"><li class="page-item @(!Model.HasPrevious ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-Page="@(Model.CurrentPage - 1)" asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter"><i class="bi bi-chevron-left"></i></a></li>@foreach (int pageNumber in Model.Pages) { <li class="page-item @(Model.CurrentPage == pageNumber ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-Page="@pageNumber" asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter">@pageNumber</a></li> }<li class="page-item @(!Model.HasNext ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-Page="@(Model.CurrentPage + 1)" asp-route-RecordsPerPage="@Model.RecordsPerPage" asp-route-Filter="@Model.Filter"><i class="bi bi-chevron-right"></i></a></li></ul></nav>
</div></div></section>
@section Scripts { <script>$(document).on('click','.btnDelete',function(e){e.preventDefault();const form=$(this).closest('form');const role=$(this).data('role');Swal.fire({icon:'question',title:'¿Desea eliminar el rol?',text:role,showCancelButton:true,confirmButtonText:'Sí, eliminar',cancelButtonText:'Cancelar'}).then(result=>{if(result.isConfirmed)form.trigger('submit');});});</script> }
